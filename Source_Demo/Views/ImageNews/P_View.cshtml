@model Source_Demo.Models.M_ImageNews

@{
    ViewData["Title"] = "Xem chi tiết ImageNews";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";

    var breadCrumb = new Source_Demo.ViewModels.VM_BreadCrumb
            {
                ParentName = "Quản lý hình ảnh tin tức",
                CurrentName = "Xem chi tiết"
            };
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("_P_BreadCrumb", breadCrumb)

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@ViewData["Title"]</h4>

        <div class="mb-3">
            <label class="form-label fw-bold">ID</label>
            <p>@Model.id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mã tin tức</label>
            <p>@Model.news_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Đường dẫn ảnh</label>
            <p>@Model.image_url</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Ảnh đại diện</label>
            <p>@(Model.is_avatar ? "Có" : "Không")</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Ngày tạo</label>
            <p>@Model.create_at</p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
