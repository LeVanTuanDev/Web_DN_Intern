@model Source_Demo.Models.EM_FieldOfActivity
@{
    ViewData["Title"] = "Chỉnh sửa lĩnh vực hoạt động";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";

    var breadCrumb = new Source_Demo.ViewModels.VM_BreadCrumb
            {
                ParentName = "Quản lý lĩnh vực hoạt động",
                CurrentName = "Chỉnh sửa"
            };
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("_P_BreadCrumb", breadCrumb)

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@ViewData["Title"]</h4>

        <form asp-action="P_Edit" method="post">
            <input type="hidden" asp-for="field_id" />

            <div class="mb-3">
                <label asp-for="field_name" class="form-label"></label>
                <input asp-for="field_name" class="form-control" />
                <span asp-validation-for="field_name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="status_" class="form-label">Trạng thái</label>
                <select asp-for="status_" class="form-select">
                    <option value="1">Hoạt động</option>
                    <option value="0">Khóa</option>
                </select>
                <span asp-validation-for="status_" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>