@model Source_Demo.Models.EM_FieldCategory
@{
    ViewData["Title"] = "Chỉnh sửa lĩnh vực";
}
@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
    <script src="~/controllers/field_manage.js" defer asp-append-version="true"></script>
}

<div class="card">
    <div class="card-header">
        <h4>Chỉnh sửa lĩnh vực</h4>
    </div>
    <div class="card-body">
        <form id="frmEditField" method="post" asp-controller="FieldManage" asp-action="P_Edit">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label">Tên lĩnh vực</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Mô tả</label>
                <textarea name="Description" class="form-control">@Model.Description</textarea>
            </div>
            <button type="submit" class="btn btn-primary">Cập nhật</button>
        </form>
    </div>
</div>
