@model Source_Demo.Models.EM_RecruitCategory

@{
    ViewData["Title"] = "Thêm mới danh mục tuyển dụng";

    Layout = "~/Views/Shared/_LayoutMaster.cshtml";



    var breadCrumb = new Source_Demo.ViewModels.VM_BreadCrumb

            {

                ParentName = "Quản lý danh mục tuyển dụng",

                CurrentName = "Thêm mới"

            };
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("_P_BreadCrumb", breadCrumb)

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@ViewData["Title"]</h4>

        <form asp-action="P_Add" method="post">
            <div class="mb-3">
                <label asp-for="recruitment_name" class="form-label"></label>
                <input asp-for="recruitment_name" class="form-control" />
                <span asp-validation-for="recruitment_name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="business_id" class="form-label"></label>
                <input asp-for="business_id" class="form-control" />
                <span asp-validation-for="business_id" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="recruitment_position" class="form-label"></label>
                <input asp-for="recruitment_position" class="form-control" />
                <span asp-validation-for="recruitment_position" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="content" class="form-label"></label>
                <textarea asp-for="content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="content" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
