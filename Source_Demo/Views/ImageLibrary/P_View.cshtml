@model Source_Demo.Models.M_ImageLibrary

@{
    ViewData["Title"] = "Xem chi tiết ImageLibrary";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";

    var breadCrumb = new Source_Demo.ViewModels.VM_BreadCrumb
            {
                ParentName = "Quản lý ImageLibrary",
                CurrentName = "Xem chi tiết"
            };
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("_P_BreadCrumb", breadCrumb)

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@ViewData["Title"]</h4>

        <div class="mb-3">
            <label class="form-label fw-bold">ID</label>
            <p>@Model.id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Library ID</label>
            <p>@Model.library_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tiêu đề video</label>
            <p>@Model.video_title</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">URL video</label>
            <p>@Model.video_url</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Thời gian đăng</label>
            <p>@Model.uploaded_at</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tài khoản</label>
            <p>@Model.username</p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
