@model Source_Demo.Models.EM_LoginAccount
@{
    Layout = "_LayoutBlank";
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link href="~/css/page-auth.css" rel="stylesheet" />

    <style>
        .login-container {
            max-width: 450px;
            margin: 0 auto;
        }
        .login-container .form-control {
            border-radius: 6px;
        }
        .login-container label.form-label {
            color: #6c63ff;
            font-weight: 600;
        }
        .btn-custom-purple {
            background-color: #6c63ff;
            color: #fff;
            border: none;
        }

        .btn-custom-purple:hover {
            background-color: #5b53e6;
            color: #fff;
        }
    </style>
}

@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
    <script src="~/controllers/account.js" defer asp-append-version="true"></script>
}

<div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner login-container">
        <div class="card px-sm-4 px-2 py-4">
            <div class="card-body">
                <h3 class="mb-4 text-center">Đăng nhập hệ thống!</h3>

                <form asp-route="Login" method="post" id="form_login" class="mb-3">
                    <div class="mb-3">
                        <label asp-for="userName" class="form-label">Tài khoản</label>
                        <input asp-for="userName" class="form-control" placeholder="Nhập tài khoản" autofocus />
                        <span asp-validation-for="userName" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-password-toggle">
                        <label asp-for="password" class="form-label">Mật khẩu</label>
                        <div class="input-group input-group-merge">
                            <input asp-for="password" type="password" class="form-control" placeholder="Nhập mật khẩu" aria-describedby="password" />
                            <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                        </div>
                        <span asp-validation-for="password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-custom-purple d-grid w-100" id="btn_submit_login">
                            Đăng nhập
                        </button>
                    </div>
                </form>

                <p class="text-center mb-0">
                    <span>Chưa có tài khoản?</span>
                    <a href="dang-ky">
                        <span>Tạo tài khoản</span>
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>