@model Source_Demo.Models.M_RecruitCategory

@{
    ViewData["Title"] = "Xem chi tiết danh mục tuyển dụng";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var breadCrumb = new Source_Demo.ViewModels.VM_BreadCrumb
            {
                ParentName = "Quản lý danh mục tuyển dụng",
                CurrentName = "Xem chi tiết"
            };
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("_P_BreadCrumb", breadCrumb)

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@ViewData["Title"]</h4>

        <div class="mb-3">
            <label class="form-label fw-bold">ID</label>
            <p>@Model.recruitment_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tên tuyển dụng</label>
            <p>@Model.recruitment_name</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mã doanh nghiệp</label>
            <p>@Model.business_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Vị trí tuyển dụng</label>
            <p>@Model.recruitment_position</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Nội dung</label>
            <p>@Model.content</p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
