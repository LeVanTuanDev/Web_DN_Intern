@model Source_Demo.Models.M_Post

@{
    ViewData["Title"] = "Xem chi tiết bài viết";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";

    var breadCrumb = new Source_Demo.ViewModels.VM_BreadCrumb
            {
                ParentName = "Quản lý bài viết",
                CurrentName = "Xem chi tiết"
            };
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("_P_BreadCrumb", breadCrumb)

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@ViewData["Title"]</h4>

        <div class="mb-3">
            <label class="form-label fw-bold">ID</label>
            <p>@Model.post_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tiêu đề</label>
            <p>@Model.title</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mô tả ngắn</label>
            <p>@Model.short_description</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Nội dung</label>
            <p>@Html.Raw(Model.content)</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Lĩnh vực (field_id)</label>
            <p>@Model.field_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Lượt xem</label>
            <p>@Model.view_count</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tài khoản</label>
            <p>@Model.username</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Trạng thái</label>
            <p>@Model.status</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Slug</label>
            <p>@Model.name_slug</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Ngày tạo</label>
            <p>@Model.create_at</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Người tạo</label>
            <p>@Model.create_by</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Ngày cập nhật</label>
            <p>@Model.update_at</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Người cập nhật</label>
            <p>@Model.update_by</p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
