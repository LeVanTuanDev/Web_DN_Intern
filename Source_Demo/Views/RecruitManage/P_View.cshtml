@model Source_Demo.Models.M_RecruitManage

@{
    ViewData["Title"] = "Xem chi tiết hồ sơ ứng tuyển";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var breadCrumb = new Source_Demo.ViewModels.VM_BreadCrumb
            {
                ParentName = "Quản lý tuyển dụng",
                CurrentName = "Xem chi tiết"
            };
}

@section Styles {
    @await Html.PartialAsync("_P_StylesTableAndFormBasic")
    <link rel="stylesheet" href="~/css/site.css" />
}
@section Scripts {
    @await Html.PartialAsync("_P_ScriptsTableAndFormBasic")
    <script src="~/js/utility_lib.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("_P_BreadCrumb", breadCrumb)

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@ViewData["Title"]</h4>

        <div class="mb-3">
            <label class="form-label fw-bold">Mã Application</label>
            <p>@Model.application_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mã tuyển dụng</label>
            <p>@Model.recruitment_id</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Họ và tên</label>
            <p>@Model.full_name</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Trình độ học vấn</label>
            <p>@Model.education_level</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Trình độ chuyên môn</label>
            <p>@Model.professional_qualifications</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Đường dẫn CV</label>
            <p>@Model.cv_url</p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
